    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        body { background-color: #121212; color: #fff; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .card { background-color: #1e1e1e; border: 1px solid #333; box-shadow: 0 4px 15px rgba(0,0,0,0.5); width: 100%; max-width: 400px; }
        .form-control { background-color: #2a2a2a; color: #fff; border: 1px solid #444; }
