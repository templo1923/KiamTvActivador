    </style>
</head>
<body>

<div class="container d-flex justify-content-center">
    <div class="card p-4">
        <div class="text-center mb-4">
            <h2><i class="fas fa-tv text-info"></i> Activación Free</h2>
            <p class="text-muted">Desbloquea 24 horas de entretenimiento</p>
        </div>

        <?= $mensaje ?>

        <form method="post" id="activacionForm">
            <div class="form-group">
                <label>Tu MAC Address (Ver en la TV)</label>
                <input type="text" class="form-control text-center" name="mac_address" id="mac" placeholder="A1:B2:C3:D4:E5:F6" required>
            </div>
            
            <div class="form-group">
                <label>Tu WhatsApp</label>
                <input type="number" class="form-control text-center" name="whatsapp" placeholder="Ej: 573001234567" required>
            </div>

            <div class="form-group text-center mt-4">
                <p class="small text-warning"><i class="fas fa-exclamation-triangle"></i> Requisito Obligatorio:</p>
                <a href="https://t.me/TuGrupoDeTelegramAqui" target="_blank" class="btn btn-telegram btn-block mb-3" id="btnTelegram" onclick="desbloquearBoton()">
                    <i class="fab fa-telegram-plane"></i> Únete a nuestro Telegram
                </a>
            </div>

            <button type="submit" class="btn btn-success btn-block btn-lg" id="btnActivar" disabled>
                <i class="fas fa-check-circle"></i> Activar 24 Horas
            </button>
        </form>
    </div>
</div>

<script>
    // 1. Auto-formato de MAC Address
    document.getElementById("mac").addEventListener('input', function (e) {
        let value = e.target.value.toUpperCase().replace(/[^0-9A-F]/g, '');
        let formatted = '';
        for (let i = 0; i < value.length && i < 12; i += 2) {
            formatted += value.substr(i, 2);
            if (i < value.length - 2 && i < 10) formatted += ':';
        }
        e.target.value = formatted;
    });

    // 2. Desbloquear botón al ir a Telegram
    function desbloquearBoton() {
        let btnActivar = document.getElementById('btnActivar');
        btnActivar.disabled = false;
        btnActivar.classList.add('btn-success');
    }
</script>

</body>
</html>