<?php
// activar_freemium.php
error_reporting(E_ALL);
ini_set('display_errors', 1);

// 1. Conexión usando PDO (Igual que en tu script de migración)
try {
    // Usamos la misma ruta relativa exacta que usas en tu panel
    $db = new PDO("sqlite:api/.db.db");
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
} catch (PDOException $e) {
    die("<div class='alert alert-danger text-center'>Error de conexión a la BD: " . $e->getMessage() . "</div>");
}

$mensaje = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['mac_address'])) {
    // 2. Limpiar y formatear la MAC a XX:XX:XX:XX:XX:XX
    $mac_limpia = strtoupper(preg_replace('/[^0-9A-F]/', '', $_POST['mac_address']));
    $mac_formateada = implode(':', str_split($mac_limpia, 2));
    
    $whatsapp = trim($_POST['whatsapp'] ?? '');
    
    // 3. DATOS MAESTROS
    $dns_id = 3; // <--- AQUÍ PONES EL DNS QUE QUIERAS (1, 3, 5, etc.)
    $master_user = 'phxXE2JdU8a';
    $master_pass = 'hd6L7e4D1m';
    $expiracion = date('Y-m-d H:i:s', strtotime('+24 hours'));
    
    try {
        // 4. Verificar si la MAC ya existe en la base de datos REAL
        $stmt_check = $db->prepare("SELECT id FROM playlist WHERE mac_address = :mac");
        $stmt_check->bindParam(':mac', $mac_formateada);
        $stmt_check->execute();
        $existe = $stmt_check->fetch(PDO::FETCH_ASSOC);

        if ($existe) {
            // 🟢 SI YA EXISTE: Actualizamos TODO, incluyendo el DNS
            $query = "UPDATE playlist SET dns_id = :d, username = :u, password = :p, expiracion = :e, is_protected = 1, cliente_whatsapp = :w WHERE mac_address = :mac";
            $stmt_update = $db->prepare($query);
            
            // PDO maneja los tipos de datos de forma automática y segura
            $stmt_update->bindParam(':d', $dns_id); 
            $stmt_update->bindParam(':u', $master_user);
            $stmt_update->bindParam(':p', $master_pass);
            $stmt_update->bindParam(':e', $expiracion);
            $stmt_update->bindParam(':w', $whatsapp);
            $stmt_update->bindParam(':mac', $mac_formateada);
            
            $stmt_update->execute();

        } else {
            // 🔵 SI ES NUEVA: La creamos de cero
            $cliente_nombre = 'Free_' . substr(md5(uniqid()), 0, 5);
            $query_insert = "INSERT INTO playlist (dns_id, mac_address, username, password, pin, cliente_nombre, cliente_whatsapp, expiracion, is_protected) VALUES (:d, :mac, :u, :p, '0000', :n, :w, :e, 1)";
            $stmt_insert = $db->prepare($query_insert);
            
            $stmt_insert->bindParam(':d', $dns_id);
            $stmt_insert->bindParam(':mac', $mac_formateada);
            $stmt_insert->bindParam(':u', $master_user);
            $stmt_insert->bindParam(':p', $master_pass);
            $stmt_insert->bindParam(':n', $cliente_nombre);
            $stmt_insert->bindParam(':w', $whatsapp);
            $stmt_insert->bindParam(':e', $expiracion);
            
            $stmt_insert->execute();
        }

        $mensaje = '<div class="alert alert-success text-center"><strong>¡Activación Exitosa!</strong><br>Tienes 24 horas de TV Gratis. Por favor, reinicia la aplicación en tu televisor.</div>';

    } catch (PDOException $e) {
        // Si SQLite se queja por algo, te lo mostrará en rojo
        $mensaje = "<div class='alert alert-danger text-center'><strong>Error en BD:</strong> " . $e->getMessage() . "</div>";
    }
}
?>
?>
